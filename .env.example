# Leave empty to run fully offline: the helper uses its built-in hint ladder and
# the judge uses a heuristic for code quality.
# Set one key. OpenRouter is used if both are set (override with LLM_PROVIDER).
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# "openrouter" or "anthropic"; leave empty to pick from whichever key is set
LLM_PROVIDER=
OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions
# 1 lets the model reason before answering (slower; hints take longer to arrive)
OPENROUTER_REASONING=0

# Models for live hints and for the final review. Leave empty for the provider default:
# OpenRouter nvidia/nemotron-3.5-lightning:free, Anthropic claude-haiku-4-5-20251001 / claude-sonnet-5-5
HELPER_MODEL=
JUDGE_MODEL=

# Sandbox: "local" (subprocess inside this container) or "judge0"
SANDBOX=local
JUDGE0_URL=http://judge0:2358
JUDGE0_TOKEN=
JUDGE0_PYTHON_ID=71
SANDBOX_MEMORY_MB=512
SANDBOX_MAX_SECONDS=20

# Optional when running without docker compose (compose sets this for you)
REDIS_URL=
